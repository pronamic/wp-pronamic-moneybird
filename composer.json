{
	"name": "pronamic/wp-pronamic-moneybird",
	"description": "This WordPress plugin provides the link between your WordPress website and your Moneybird administration.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true
		},
		"wp-slug": "pronamic-moneybird"
	},
	"autoload": {
		"psr-4": {
			"Pronamic\\Moneybird\\": "src/"
		}
	},
	"require": {
		"php": "^8.2",
		"automattic/jetpack-autoloader": "^3.0",
		"pronamic/wp-http": "^1.2",
		"pronamic/wp-html": "^2.2"
	},
	"require-dev": {
		"pronamic/wp-coding-standards": "^2.1",
		"pronamic/pronamic-cli": "^1.1",
		"roots/wordpress-no-content": "^7.1",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"deployer/deployer": "^7.5",
		"rector/rector": "^2.6"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-moneybird/",
			"vendor/bin/wp i18n make-pot ./build/pronamic-moneybird/ --slug=pronamic-moneybird",
			"vendor/bin/wp i18n make-mo ./build/pronamic-moneybird/languages/",
			"vendor/bin/wp dist-archive ./build/pronamic-moneybird/ --plugin-dirname=pronamic-moneybird --force"
		],
		"deploy": [
			"Composer\\Config::disableProcessTimeout",
			"DEPLOYER_IMPORT=${DEPLOYER_IMPORT:-$HOME/deployer.php} vendor/bin/dep deploy"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=pronamic-moneybird",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/pronamic-moneybird/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/pronamic-moneybird.pot"
		],
		"rector": "vendor/bin/rector"
	}
}
